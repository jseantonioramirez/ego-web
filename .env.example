# Copia este archivo a .env.local para desarrollo (Vercel usa sus propias
# variables de entorno del proyecto — no subas nunca .env.local a git).

# Tu API key de Anthropic. Créala en https://console.anthropic.com
# (Settings -> API Keys). Requiere tener facturación activada.
ANTHROPIC_API_KEY=

# El ID del modelo de Claude que quieres usar como motor de EGO.
# Consulta el ID actual en https://docs.anthropic.com/en/docs/about-claude/models
# (cambia con el tiempo, por eso no viene fijado por defecto).
ANTHROPIC_MODEL=

# --- Voz de "Sala EGO" (ElevenLabs, /api/speak) -------------------------
# Tu API key de ElevenLabs. Créala en https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ID de la voz por defecto (masculina / fallback si no hay ninguna otra
# configurada). Voice Library o tus propias voces -> "..." -> Copy Voice ID.
ELEVENLABS_VOICE_ID=

# ID de la voz femenina normal. Opcional: si la dejas vacía, /api/speak
# cae a ELEVENLABS_VOICE_ID de arriba.
ELEVENLABS_VOICE_ID_FEMALE=

# ID del clon de la voz real de la abuela (Voice Library -> Instant Voice
# Cloning, subiendo su grabación). Opcional: si la dejas vacía, la opción
# "abuela" cae a ELEVENLABS_VOICE_ID_FEMALE (o a la masculina si tampoco
# esa está configurada) — nada se rompe mientras tanto.
ELEVENLABS_VOICE_ID_ABUELA=

# Base de datos de casos anónimos (lib/db.ts). En Vercel no hace falta
# rellenar esto a mano: al vincular una base de datos Postgres al proyecto
# (Storage -> Create Database -> Postgres), Vercel inyecta POSTGRES_URL
# automáticamente en producción. Para desarrollo local, copia el valor
# desde Vercel (Settings -> Environment Variables) o usa `vercel env pull`.
POSTGRES_URL=

# --- Cobro (Stripe) — preparado, no activado ---------------------------
# No hace falta rellenar nada de esto hoy: sin estas variables, EGO
# funciona con normalidad y /api/checkout y /api/webhook/stripe
# simplemente responden que el cobro no está activado. Ver README,
# sección "Cobro (Stripe)" para la guía paso a paso cuando toque activarlo.

# Settings -> API keys en tu cuenta de Stripe. Empieza por sk_live_ (o
# sk_test_ mientras pruebas) — nunca la publiques ni la subas a git.
STRIPE_SECRET_KEY=

# Se genera al crear el endpoint de webhook en Stripe (Developers ->
# Webhooks -> Add endpoint, apuntando a /api/webhook/stripe). Empieza por whsec_.
STRIPE_WEBHOOK_SECRET=

# El ID del Price del plan anual (Product catalog -> tu producto -> Price),
# no el del Product. Empieza por price_.
STRIPE_PRICE_ID_ANNUAL=

# Lo mismo que arriba pero para el plan mensual. Puedes rellenar solo uno
# de los dos (mensual o anual) si de momento no quieres ofrecer ambos.
STRIPE_PRICE_ID_MONTHLY=

# URL pública de la web, para las redirecciones de Checkout si Stripe no
# manda cabecera "origin" (normalmente no hace falta: en local y en Vercel
# ya se detecta solo). Solo rellénala si algún día ves redirecciones a una
# URL vacía o incorrecta.
NEXT_PUBLIC_APP_URL=
